# Large NGS data and raw sequences (>100MB)
*.fq
*.fastq
*.tar

# Theo dõi đầy đủ mã nguồn trong src/
!src/
!src/**

# Thư mục data/: Bỏ qua mọi file dữ liệu bên trong, chỉ giữ lại thư mục rỗng (.gitkeep) trên GitHub
data/*
!data/.gitkeep
output/
!output/.gitkeep
# Pangenome graph files & indexes (dữ liệu đồ thị nặng sinh ra khi chạy)
*.gfa
*.og
*.gbz
*.dist
*.min
*.xg
*.pg

# Alignment and variant files
*.sam
*.bam
*.bai
*.gaf
*.vcf

# Temporary files and scratch scripts
scratch/
*.tmp
*.log

# System and OS files
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.vscode/
